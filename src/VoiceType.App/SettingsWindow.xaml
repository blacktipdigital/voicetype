<Window x:Class="VoiceType.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceType Settings"
        Width="520" Height="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FAFAFA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Microphone" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
        <ComboBox x:Name="MicCombo" Grid.Row="1" Height="30" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="OpenAI API key" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock x:Name="KeyStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Margin="10,0,0,0" FontSize="12" Foreground="#5F6368"/>
            <PasswordBox x:Name="KeyBox" Height="30" VerticalContentAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="4" Background="#FEF7E0" BorderBrush="#F9AB00" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#3C4043">
                Read before saving a key: dictation audio leaves this PC and is sent to
                OpenAI for transcription. OpenAI does not train models on API data by
                default, but retains Realtime and Responses API data for abuse monitoring
                for up to 30 days unless your account has approved retention controls.
                VoiceType stores no audio on this PC; the key is encrypted with Windows
                DPAPI for this user only.
            </TextBlock>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,0,0,6">
            <TextBlock x:Name="DictionaryStatus" DockPanel.Dock="Right" FontSize="12"
                       Foreground="#188038" VerticalAlignment="Center"/>
            <TextBlock FontWeight="SemiBold" FontSize="13"
                       Text="Custom dictionary (exact spellings the cleanup pass must use)"/>
        </DockPanel>
        <Grid Grid.Row="6" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTermBox" Grid.Column="0" Height="28" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Add" Width="70" Height="28" Margin="8,0,0,0" Click="OnAddTerm"/>
            <Button x:Name="RemoveTermButton" Grid.Column="2" Content="Remove" Width="70" Height="28"
                    Margin="8,0,0,0" IsEnabled="False" Click="OnRemoveTerm"/>
        </Grid>
        <ListBox x:Name="TermsList" Grid.Row="7" MinHeight="80" Margin="0,0,0,12" FontSize="12"
                 SelectionChanged="OnTermSelectionChanged"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RemoveKeyButton" Content="Remove key" Width="100" Height="30"
                    Margin="0,0,8,0" Click="OnRemoveKey"/>
            <Button Content="Save" Width="90" Height="30" Margin="0,0,8,0" Click="OnSave"/>
            <Button Content="Close" Width="80" Height="30" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
