<Window x:Class="VoiceType.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceType History (last 7 days)"
        Width="640" Height="480"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="EntryList" Grid.Row="0" SelectionChanged="OnSelectionChanged"
                 FontSize="12" HorizontalContentAlignment="Stretch"/>

        <TextBlock Grid.Row="1" Text="Full text (selected)" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4"/>
        <TextBox x:Name="FullText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyButton" Content="Copy" Width="90" Height="30" Margin="0,0,8,0"
                    IsEnabled="False" Click="OnCopy"/>
            <Button x:Name="DeleteButton" Content="Delete" Width="90" Height="30" Margin="0,0,8,0"
                    IsEnabled="False" Click="OnDelete"/>
            <Button Content="Close" Width="80" Height="30" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
